.d-swiper {
  width: 100%;
  height: 560rpx;
}
.d-swiper__img {
  width: 100%;
  height: 100%;
  display: block;
  background: linear-gradient(110deg, rgba(44, 24, 16, 0.08), rgba(255, 255, 255, 0.35), rgba(44, 24, 16, 0.08));
  background-size: 200% 100%;
  animation: detail-img-skeleton 1.2s ease-in-out infinite;
}
.d-swiper__img--loaded {
  animation: none;
  background-color: rgba(44, 24, 16, 0.04);
}
.d-body {
  padding: 0 var(--page-pad-x);
  padding-bottom: 160rpx;
  margin-top: -72rpx;
  position: relative;
  z-index: 2;
}
.d-hero-card {
  padding: var(--sp-5);
  background:
    linear-gradient(145deg, rgba(253, 252, 250, 0.94), rgba(247, 238, 226, 0.98)),
    var(--color-surface);
  overflow: hidden;
}
.theme-dark .d-hero-card {
  background:
    linear-gradient(145deg, rgba(44, 24, 16, 0.7), rgba(30, 30, 30, 0.98)),
    var(--color-surface);
}
.d-kicker {
  display: block;
  margin-bottom: var(--sp-2);
  font-size: var(--fs-kicker);
  letter-spacing: 0.2em;
  color: var(--color-accent);
}
.d-title {
  font-size: var(--fs-display);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.d-sub {
  display: block;
  margin-top: var(--sp-2);
  line-height: var(--lh-readable);
  font-size: var(--fs-sub);
}
.d-flavors {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}
.d-flavor {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--fs-caption);
  color: var(--color-brand);
  background: var(--color-accent-12);
}
.d-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: 20rpx;
}
.d-tag {
  font-size: var(--fs-kicker);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-accent-12);
  color: var(--color-accent);
}
.story-card {
  margin-top: var(--sp-4);
  padding: var(--sp-card-y);
}
.story-card__hd {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  margin-bottom: var(--sp-4);
}
.story-card__kicker {
  font-size: var(--fs-kicker);
  letter-spacing: 0.18em;
  color: var(--color-accent);
}
.story-card__title {
  font-size: var(--fs-section);
  font-weight: 700;
  color: var(--color-text);
}
.story-feature {
  padding: var(--sp-4);
  border-radius: 24rpx;
  background: var(--color-accent-10);
  margin-bottom: 18rpx;
}
.story-feature__label,
.story-item__label {
  display: block;
  font-size: var(--fs-caption);
  color: var(--color-accent);
  margin-bottom: 10rpx;
}
.story-feature__text {
  display: block;
  font-size: var(--fs-body);
  line-height: var(--lh-relaxed);
  color: var(--color-text);
}
.story-grid {
  display: flex;
  gap: 18rpx;
}
.story-item {
  flex: 1;
  min-width: 0;
  min-height: 172rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg);
}
.story-item__text {
  display: block;
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
  color: var(--color-text-secondary);
}
.share-card {
  margin-top: var(--sp-4);
  padding: var(--sp-card-y) 0 var(--sp-card-y) var(--sp-card-y);
  overflow: hidden;
}
.share-card__hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
  padding-right: var(--sp-card-y);
}
.share-card__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}
.share-upload-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: var(--fs-caption);
  font-weight: 600;
  background: var(--color-brand) !important;
  color: var(--color-on-brand) !important;
  line-height: 1;
}
.share-upload-btn::after {
  display: none;
}
.share-empty {
  padding: 36rpx 0 10rpx;
}
.share-empty__text {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}
.share-card__kicker {
  display: block;
  font-size: var(--fs-kicker);
  letter-spacing: 0.18em;
  color: var(--color-accent);
}
.share-card__title {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-section);
  font-weight: 700;
  color: var(--color-text);
}
.share-card__sub {
  display: block;
  margin-top: 14rpx;
  padding-right: var(--sp-card-y);
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
  color: var(--color-text-secondary);
}
.share-scroll {
  width: 100%;
  margin-top: var(--sp-4);
  white-space: nowrap;
}
.share-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: var(--sp-card-y);
  padding-bottom: 6rpx;
}
.share-item {
  width: 360rpx;
  overflow: hidden;
  display: inline-block;
  vertical-align: top;
  white-space: normal;
  border-radius: 26rpx;
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
}
.share-item__img {
  width: 360rpx;
  height: 300rpx;
  display: block;
  background: var(--color-border);
}
.share-item__body {
  padding: 20rpx;
}
.share-user {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
 
.share-user__avatar {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: var(--fs-kicker);
  font-weight: 600;
}
.share-user__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.share-item__comment {
  display: block;
  min-height: 78rpx;
  margin-top: 14rpx;
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
  color: var(--color-text-secondary);
}
.share-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: var(--sp-3);
}
.share-tag {
  font-size: var(--fs-kicker);

  color: var(--color-accent);
}
/* ── 上传分享面板 ── */
.up-root {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.up-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
}
.up-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 82vh;
  max-height: 92vh;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  color: var(--color-text);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.14);
  animation: up-slide-in 0.32s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}
@keyframes up-slide-in {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.up-scroll {
  flex: 1;
  height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.up-title {
  padding: var(--sp-1) 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}
.up-title__eyebrow {
  font-size: var(--fs-kicker);

  letter-spacing: 0.18em;
  color: var(--color-accent);
}
.up-title__main {
  font-size: var(--fs-panel);

  font-weight: 700;
  color: var(--color-text);
}
.up-title__sub {
  font-size: var(--fs-sm);
  line-height: var(--lh-readable);

  color: var(--color-text-secondary);
}
.up-section {
  margin-bottom: var(--sp-5);
}
.up-label {
  display: block;
  font-size: var(--fs-body);

  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--sp-3);
}
.up-required {
  font-size: var(--fs-caption);

  font-weight: 400;
  color: var(--color-accent);
  margin-left: var(--sp-1);
}
.up-hint-label {
  font-size: var(--fs-caption);

  font-weight: 400;
  color: var(--color-text-secondary);
}
.up-img-area {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--color-accent);
  background: var(--color-accent-06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.up-img-preview {
  width: 100%;
  height: 100%;
  display: block;
}
.up-img-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.52);
  color: #fff;
  font-size: var(--fs-body);
}
.up-img-icon {
  font-size: var(--fs-mega);
  color: var(--color-accent);
  line-height: 1;
  margin-bottom: var(--sp-1);
}
.up-img-hint {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}
.up-textarea {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  font-size: var(--fs-sub);
  line-height: var(--lh-body);
  color: var(--color-text);
}
.up-input {
  width: 100%;
  box-sizing: border-box;
  min-height: var(--touch-target-min);
  height: var(--touch-target-min);
  padding: 0 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  font-size: var(--fs-sub);
  color: var(--color-text);
}
.up-placeholder {
  color: var(--color-text-secondary);
}
.up-gap { height: 20rpx; }
.up-foot {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}
.up-foot__cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--color-border) !important;
  color: var(--color-text-secondary) !important;
}
.up-foot__cancel::after { display: none; }
.up-foot__submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--color-brand) !important;
  color: var(--color-on-brand) !important;
}
.up-foot__submit::after { display: none; }

/* ── 加购成功 · 居中卡片 ── */
.addok-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1002;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx var(--page-pad-x);
  box-sizing: border-box;
}
.addok-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 20, 16, 0.48);
}
.addok-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 608rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 28rpx;
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  animation: addok-pop 0.28s cubic-bezier(0.25, 0.82, 0.28, 1) forwards;
}
@keyframes addok-pop {
  from {
    opacity: 0;
    transform: scale(0.94) translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
.addok-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.addok-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-on-brand);
  background: var(--color-brand);
  box-shadow: 0 8rpx 24rpx rgba(61, 31, 13, 0.18);
}
.addok-title {
  font-size: var(--fs-panel);
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  letter-spacing: 0.02em;
}
.addok-preview {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-accent-06);
  margin-bottom: 28rpx;
}
.addok-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(61, 31, 13, 0.06);
}
.addok-preview-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.addok-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.addok-spec {
  font-size: var(--fs-caption);
  line-height: var(--lh-readable);
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.addok-qty {
  font-size: var(--fs-caption);
  color: var(--color-accent);
  font-weight: 500;
}
.addok-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}
.addok-copy-line {
  display: block;
  font-size: var(--fs-sm);
  line-height: var(--lh-readable);
  color: var(--color-text-secondary);
  text-align: center;
}
.addok-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.addok-btn {
  width: 100%;
  margin: 0;
  height: var(--touch-target-min);
  line-height: var(--touch-target-min);
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.addok-btn::after {
  display: none;
}
.addok-btn--primary {
  background: var(--color-brand) !important;
  color: var(--color-on-brand) !important;
  border: none !important;
}
.addok-btn--ghost {
  background: transparent !important;
  color: var(--color-brand) !important;
  border: 1rpx solid var(--color-border) !important;
}

/* ── end upload ── */

.d-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: var(--sp-3) var(--page-pad-x);
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
}
.d-bar__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-brand) !important;
  color: var(--color-on-brand) !important;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
}
.d-bar__btn::after {
  display: none;
}
.d-bar__btn[disabled] {
  opacity: 0.45;
}
.detail {
  min-height: 100vh;
  padding-bottom: 140rpx;
}
@keyframes detail-img-skeleton {
  0% {
    background-position: 180% 0;
  }
  100% {
    background-position: -80% 0;
  }
}
