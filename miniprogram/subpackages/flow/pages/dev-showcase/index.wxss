.showcase {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 88rpx;
  background:
    radial-gradient(circle at 20% 0%, rgba(201, 149, 98, 0.22), transparent 30%),
    var(--color-bg);
}
.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 34rpx 34rpx;
  margin-bottom: 36rpx;
  background:
    linear-gradient(135deg, rgba(44, 24, 16, 0.92), var(--color-accent-86)),
    var(--color-brand);
  color: #fff8f0;
}
.hero::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -72rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 248, 240, 0.12);
}
.hero__eyebrow,
.section__kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--color-accent);
}
.hero__eyebrow {
  color: rgba(255, 248, 240, 0.76);
}
.hero__title {
  display: block;
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}
.hero__desc {
  display: block;
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  max-width: 560rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: rgba(255, 248, 240, 0.82);
}
.hero__stats {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.stat {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 248, 240, 0.12);
}
.stat__value,
.stat__label {
  display: block;
}
.stat__value {
  font-size: 42rpx;
  font-weight: 700;
}
.stat__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 248, 240, 0.72);
}
.section {
  margin-bottom: 42rpx;
}
.section__hd {
  margin-bottom: 20rpx;
}
.section__title {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.section__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
.shot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.shot-card {
  min-height: 150rpx;
  padding: 20rpx 16rpx;
}
.shot-card__title,
.shot-card__note,
.script-card__title,
.script-card__hook,
.step__text,
.outline__text,
.case-card__title,
.case-card__body,
.scope-card__title,
.scope-row__text,
.process__title,
.process__desc,
.tech-card__title,
.tech-card__text {
  display: block;
}
.shot-card__title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.shot-card__note {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}
.script-card,
.outline,
.case-card,
.scope-card,
.tech-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.script-card__top {
  margin-bottom: 18rpx;
}
.script-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.script-card__hook {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}
.step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}
.step__dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--color-accent);
  flex-shrink: 0;
}
.step__text,
.outline__text,
.scope-row__text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
}
.outline__row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.outline__row:last-child {
  border-bottom: none;
}
.outline__idx,
.process__num {
  flex-shrink: 0;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--color-accent);
}
.case-card__title,
.scope-card__title,
.tech-card__title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.case-card__body,
.tech-card__text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}
.deliverables {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}
.tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  background: rgba(201, 149, 98, 0.14);
}
.pitch-btn {
  min-height: var(--touch-target-min);
  height: var(--touch-target-min);
  line-height: var(--touch-target-min);
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: var(--color-brand);
  color: #fff8f0;
  font-size: 26rpx;
  font-weight: 600;
}
.scope-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}
.scope-row__mark {
  color: var(--color-accent);
  font-size: 28rpx;
  line-height: 1.4;
}
.process {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.process__item {
  padding: 24rpx;
}
.process__title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.process__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}
