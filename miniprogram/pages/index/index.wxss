.page {
  min-height: 100vh;
  padding-bottom: var(--sp-4);
}
.nav {
  background: var(--color-bg);
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--color-border);
}
.nav__inner {
  height: 88rpx;
  padding: 0 var(--page-pad-x);
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.nav__title {
  font-size: var(--fs-display);
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--color-brand);
  filter: blur(10rpx);
  opacity: 0;
  animation: brand-focus 0.72s ease-out forwards;
}
.content {
  padding: 0 var(--page-pad-x) var(--sp-6);
}
.hero {
  position: relative;
  height: 520rpx;
  margin: 10rpx 0 28rpx;
  overflow: visible;
}
.hero__ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(18rpx);
  opacity: 0.78;
  pointer-events: none;
}
.hero__ambient--one {
  width: 220rpx;
  height: 220rpx;
  right: -42rpx;
  top: -36rpx;
  background: rgba(201, 149, 98, 0.28);
}
.theme-dark .hero__ambient--one {
  background: var(--color-accent-18);
}
.hero__ambient--two {
  width: 280rpx;
  height: 180rpx;
  left: -52rpx;
  bottom: 18rpx;
  background: rgba(247, 220, 197, 0.5);
}
.theme-dark .hero__ambient--two {
  background: var(--color-accent-12);
}
.hero__swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 28rpx 76rpx rgba(44, 24, 16, 0.22);
  transition: transform 0.18s ease-out;
}
.theme-dark .hero__swiper {
  box-shadow: 0 28rpx 76rpx rgba(0, 0, 0, 0.45);
}
.hero__swiper-dots.wx-swiper-dots {
  bottom: 200rpx;
}
.hero__swiper-dots .wx-swiper-dot {
  width: 12rpx !important;
  height: 12rpx !important;
}
.hero__slide {
  position: relative;
  height: 100%;
  width: 100%;
  overflow: hidden;
  border-radius: 40rpx;
  box-sizing: border-box;
  background: linear-gradient(110deg, rgba(44, 24, 16, 0.1), rgba(255, 255, 255, 0.36), rgba(44, 24, 16, 0.1));
  background-size: 200% 100%;
  animation: hero-skeleton 1.2s ease-in-out infinite;
}
.theme-dark .hero__slide {
  background: linear-gradient(110deg, rgba(0, 0, 0, 0.2), rgba(255, 255, 255, 0.12), rgba(0, 0, 0, 0.2));
}
.hero__slide--loaded {
  animation: none;
}
.hero__img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero__shade {
  position: absolute;
  inset: 0;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 78% 16%, rgba(255, 238, 214, 0.2), transparent 30%),
    linear-gradient(180deg, rgba(28, 20, 16, 0.08), rgba(28, 20, 16, 0.72));
  pointer-events: none;
}
.hero__copy {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 38rpx;
  z-index: 2;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.hero__eyebrow {
  font-size: var(--fs-kicker);
  letter-spacing: 0.18em;
  opacity: 0.78;
}
.hero__title {
  max-width: 520rpx;
  font-size: var(--fs-hero);
  line-height: 1.16;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.hero__desc {
  max-width: 470rpx;
  font-size: var(--fs-sm);
  line-height: var(--lh-readable);
  color: rgba(255, 255, 255, 0.82);
}
.hero__cta {
  align-self: flex-start;
  margin-top: var(--sp-2);
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--fs-sm);
  backdrop-filter: blur(12rpx);
}
.hero__cta-texts {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}
.hero__cta-sub {
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.76);
}
.hero__arrow {
  font-size: var(--fs-body);
}
@keyframes mood-inspire-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes mood-inspire-panel-in {
  from {
    opacity: 0;
    transform: translateY(calc(100% + 32rpx));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.mood-inspire-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
}
.mood-inspire-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 20, 16, 0.48);
  opacity: 0;
  animation: mood-inspire-mask-in 0.26s ease-out forwards;
}
.mood-inspire-panel {
  position: absolute;
  left: var(--page-pad-x);
  right: var(--page-pad-x);
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 32rpx 28rpx 28rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(247, 238, 226, 0.98)),
    var(--color-surface);
  box-shadow: 0 24rpx 80rpx rgba(44, 24, 16, 0.2);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  opacity: 0;
  animation: mood-inspire-panel-in 0.4s cubic-bezier(0.28, 0.82, 0.22, 1) forwards;
}
.theme-dark .mood-inspire-panel {
  background:
    linear-gradient(145deg, rgba(44, 24, 16, 0.88), rgba(26, 26, 26, 0.96)),
    var(--color-surface);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
}
.mood-inspire-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--color-text);
}
.mood-inspire-hint {
  font-size: var(--fs-caption);
  line-height: var(--lh-readable);
  color: var(--color-text-secondary);
}
.mood-inspire-field {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-accent-12);
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: var(--lh-readable);
}
.theme-dark .mood-inspire-field {
  background: rgba(255, 255, 255, 0.08);
}
.mood-inspire-placeholder {
  color: var(--color-text-secondary);
  opacity: 0.65;
}
.mood-inspire-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
}
.mood-inspire-btn {
  flex: 1;
  margin: 0;
  padding: 22rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.2;
}
.mood-inspire-btn::after {
  border: none;
}
.mood-inspire-btn--ghost {
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}
.theme-dark .mood-inspire-btn--ghost {
  background: rgba(255, 255, 255, 0.08);
}
.mood-inspire-btn--primary {
  background: var(--color-brand);
  color: #fff;
  border: none;
}
.theme-dark .mood-inspire-btn--primary {
  background: var(--color-accent);
  color: var(--color-bg);
}
.mood-inspire-btn[disabled] {
  opacity: 0.5;
}
.mood-result-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 210;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--page-pad-x);
  padding-bottom: calc(var(--page-pad-x) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.mood-result-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 20, 16, 0.52);
}
.mood-result-panel {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 82vh;
  overflow-y: auto;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(155deg, rgba(255, 255, 255, 0.94), rgba(247, 238, 226, 0.99)),
    var(--color-surface);
  box-shadow: 0 32rpx 96rpx rgba(44, 24, 16, 0.22);
  box-sizing: border-box;
}
.theme-dark .mood-result-panel {
  background:
    linear-gradient(155deg, rgba(44, 24, 16, 0.9), rgba(26, 26, 26, 0.98)),
    var(--color-surface);
  box-shadow: 0 32rpx 96rpx rgba(0, 0, 0, 0.5);
}
.mood-result-head {
  margin-bottom: 22rpx;
}
.mood-result-kicker {
  display: block;
  font-size: var(--fs-kicker);
  letter-spacing: 0.2em;
  color: var(--color-accent);
  margin-bottom: 8rpx;
}
.mood-result-title {
  display: block;
  font-size: var(--fs-panel);
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--color-text);
  line-height: var(--lh-tight);
}
.mood-result-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: var(--color-accent-06);
  border: 1rpx solid var(--color-accent-12);
  margin-bottom: 22rpx;
}
.theme-dark .mood-result-card {
  background: rgba(255, 255, 255, 0.06);
}
.mood-result-cover {
  width: 148rpx;
  height: 148rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
}
.mood-result-cover--placeholder {
  background: linear-gradient(135deg, var(--color-accent-18), var(--color-accent-10));
}
.mood-result-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.mood-result-name {
  font-size: var(--fs-title-sm);
  font-weight: 700;
  color: var(--color-text);
  line-height: var(--lh-snug);
}
.mood-result-sub {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-readable);
}
.mood-result-celebration-wrap {
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(201, 149, 98, 0.16);
  border: 1rpx solid var(--color-accent-12);
  margin-bottom: 16rpx;
}
.theme-dark .mood-result-celebration-wrap {
  background: rgba(255, 255, 255, 0.08);
}
.mood-result-celebration {
  font-size: var(--fs-caption);
  line-height: var(--lh-readable);
  font-weight: 600;
  color: var(--color-text);
}
.mood-result-quote {
  padding: 22rpx 22rpx 22rpx 26rpx;
  border-radius: 20rpx;
  border-left: 6rpx solid var(--color-accent);
  background: rgba(255, 255, 255, 0.55);
  margin-bottom: 28rpx;
}
.theme-dark .mood-result-quote {
  background: rgba(255, 255, 255, 0.06);
}
.mood-result-reason {
  font-size: var(--fs-body);
  line-height: var(--lh-relaxed);
  color: var(--color-text);
}
.mood-result-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.mood-result-actions--stack {
  flex-direction: column;
}
.mood-result-actions-row {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
}
.mood-result-btn--full {
  flex: none;
  width: 100%;
}
.mood-result-btn--half {
  flex: 1;
}
.mood-result-btn {
  flex: 1;
  margin: 0;
  padding: 22rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.2;
  min-height: var(--touch-target-min);
}
.mood-result-btn::after {
  border: none;
}
.mood-result-btn--ghost {
  background: rgba(255, 255, 255, 0.65);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}
.theme-dark .mood-result-btn--ghost {
  background: rgba(255, 255, 255, 0.08);
}
.mood-result-btn--primary {
  background: var(--color-brand);
  color: var(--color-on-brand);
  border: none;
}
.theme-dark .mood-result-btn--primary {
  background: var(--color-accent);
  color: var(--color-bg);
}
.mood-panel {
  position: relative;
  margin: 0 0 34rpx;
  padding: 28rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(247, 238, 226, 0.96)),
    var(--color-surface);
}
.theme-dark .mood-panel {
  background:
    linear-gradient(135deg, rgba(44, 24, 16, 0.7), rgba(30, 30, 30, 0.96)),
    var(--color-surface);
}
.mood-panel__hd {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.mood-panel__titles {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.mood-panel__collapse {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
  padding-top: 4rpx;
}
.mood-panel__kicker {
  font-size: var(--fs-kicker);

  letter-spacing: 0.18em;
  color: var(--color-accent);
}
.mood-panel__title {
  font-size: var(--fs-body);

  font-weight: 600;
  color: var(--color-text);
}
.mood-peek {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.mood-peek__btn {
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid var(--color-accent-12);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.mood-peek__btn--alt {
  background: rgba(255, 255, 255, 0.42);
}
.theme-dark .mood-peek__btn {
  background: rgba(255, 255, 255, 0.06);
}
.theme-dark .mood-peek__btn--alt {
  background: rgba(255, 255, 255, 0.09);
}
.mood-peek__btn-label {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text);
}
.mood-peek__btn-note {
  font-size: var(--fs-caption);
  line-height: var(--lh-readable);
  color: var(--color-text-secondary);
}
.mood-peek__hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-caption);
  line-height: var(--lh-readable);
  color: var(--color-text-secondary);
  text-align: center;
}
.mood-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.mood-row {
  display: flex;
  gap: 14rpx;
}
.mood-card {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid var(--color-accent-12);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--sp-1);
}

.theme-dark .mood-card {
  background: rgba(255, 255, 255, 0.06);
}
.mood-card__label {
  font-size: var(--fs-body);

  font-weight: 600;
  color: var(--color-text);
}
.mood-card__note {
  font-size: var(--fs-caption);

  color: var(--color-text-secondary);
}
.section__hd {
  margin: var(--sp-1) 0 var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.section__hd .sub {
  margin-top: 4rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}
.grid__item {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}
.rec-card {
  opacity: 0;
  transform: translateY(34rpx);
  animation: rec-in 0.55s ease-out forwards;
}
@keyframes brand-focus {
  to {
    opacity: 1;
    filter: blur(0);
  }
}
@keyframes rec-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes hero-skeleton {
  0% {
    background-position: 180% 0;
  }
  100% {
    background-position: -80% 0;
  }
}
