.sk {
  padding: 24rpx 32rpx 48rpx;
}
.sk__banner {
  height: 360rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  background: rgba(44, 24, 16, 0.08);
}
.sk__row {
  height: 40rpx;
  width: 40%;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  background: rgba(44, 24, 16, 0.06);
}
.sk__grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}
.sk__cell {
  width: calc(50% - 24rpx);
  margin: 12rpx;
  height: 400rpx;
  border-radius: 24rpx;
  background: rgba(44, 24, 16, 0.06);
}
.sk__shine {
  position: relative;
  overflow: hidden;
}
.sk__shine::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: sk-move 1.1s ease-in-out infinite;
}
@keyframes sk-move {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}
